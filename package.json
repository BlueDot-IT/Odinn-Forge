{
  "name": "odinn",
  "version": "1.2.0",
  "private": true,
  "description": "Local AI assistant with memory, audited tools, and user-controlled actions",
  "type": "module",
  "bin": {
    "odinn": "./apps/cli/src/cli.ts"
  },
  "packageManager": "pnpm@10.14.0",
  "pnpm": {
    "overrides": {
      "@types/node": "24.13.3",
      "uuid@<11.1.1": "11.1.1",
      "brace-expansion@<5.0.9": "5.0.9",
      "qs@<6.16.0": "6.16.0"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "check:architecture": "node scripts/ci/check-dependency-direction.ts",
    "format:check": "node scripts/ci/run.ts format",
    "lint": "node scripts/ci/run.ts lint",
    "typecheck": "node scripts/ci/run.ts typecheck",
    "build:console": "node scripts/build-console.ts",
    "test": "pnpm build:console && node --test --test-concurrency=1 --test-reporter=spec tests/*.test.ts",
    "test:platform": "pnpm build:console && node --test --test-concurrency=1 --test-reporter=spec tests/platform.test.ts tests/package-manager.test.ts tests/resource-limits.test.ts tests/channels.test.ts tests/gateway-product-surfaces.test.ts tests/compiled-inference-smoke.test.ts tests/workspace-inspection.test.ts tests/dependency-direction.test.ts",
    "test:gateway": "pnpm build:console && node --test --test-concurrency=1 --test-reporter=spec tests/gateway.test.ts tests/gateway-product-surfaces.test.ts tests/gateway-read-router.test.ts",
    "test:integration": "pnpm build:console && node --test --test-concurrency=1 --test-reporter=spec tests/integration.test.ts",
    "test:invariants": "node --expose-gc --test --test-concurrency=1 --test-reporter=spec tests/invariants/*.test.ts",
    "test:oci": "node --test --test-concurrency=1 --test-reporter=spec tests/sandbox-oci.integration.test.ts tests/extension-oci.integration.test.ts",
    "test:migrations": "node --test --test-concurrency=1 --test-reporter=spec tests/state-migrations.test.ts",
    "test:lifecycle": "node --test --test-concurrency=1 --test-reporter=spec tests/application-lifecycle.test.ts tests/state-lifecycle.test.ts",
    "test:browser-lifecycle": "node --test --test-concurrency=1 --test-reporter=spec tests/browser-state-lifecycle.integration.test.ts",
    "uat:phase-c": "pnpm build:console && node --test --test-concurrency=1 --test-reporter=spec tests/phase-c-operator-uat.test.ts",
    "uat:phase-c:human": "pnpm build:console && node scripts/uat/phase-c-harness.ts",
    "test:portable": "node scripts/ci/portable.ts",
    "test:update": "node --test --test-concurrency=1 --test-reporter=spec --test-name-pattern=update tests/application-lifecycle.test.ts",
    "test:rollback": "node --test --test-concurrency=1 --test-reporter=spec --test-name-pattern=rollback tests/application-lifecycle.test.ts",
    "test:backup": "node --test --test-concurrency=1 --test-reporter=spec --test-name-pattern=backup tests/state-lifecycle.test.ts",
    "test:restore": "node --test --test-concurrency=1 --test-reporter=spec --test-name-pattern=restore tests/state-lifecycle.test.ts",
    "test:uninstall": "node --test --test-concurrency=1 --test-reporter=spec --test-name-pattern=uninstall tests/application-lifecycle.test.ts",
    "fuzz:security": "node scripts/ci/security-fuzz.ts",
    "fuzz:replay": "node scripts/ci/security-fuzz.ts",
    "test:compiled-release": "pnpm build && pnpm release:package && pnpm release:checksums && node scripts/release/verify.ts && node --test --test-concurrency=1 --test-reporter=spec tests/v1/compiled-release.test.ts",
    "build": "node scripts/ci/run.ts build",
    "build:production": "node scripts/build-production.ts",
    "check": "pnpm check:architecture && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm smoke:onboarding && pnpm build",
    "odinn": "node ./apps/cli/src/cli.ts",
    "onboard": "pnpm --filter @odinn/cli start -- onboard",
    "tui": "pnpm --filter @odinn/cli start -- tui",
    "gui:start": "pnpm --filter @odinn/gateway start",
    "host:start": "node apps/gateway/src/host.ts",
    "smoke:inference": "pnpm build:console && node scripts/ci/inference-smoke.ts",
    "smoke:inference:compiled": "node scripts/ci/compiled-inference-smoke.ts",
    "smoke:onboarding": "node scripts/ci/onboarding-smoke.ts",
    "storage:drill": "node scripts/ci/storage-drill.ts",
    "soak:audit": "node scripts/ci/audit-soak.ts",
    "slo:measure": "node scripts/ci/slo-measurement.ts run",
    "slo:validate": "node scripts/ci/slo-measurement.ts validate",
    "state:growth": "node scripts/ci/state-growth.ts",
    "soak:long": "node scripts/ci/long-soak.ts",
    "release:preflight": "node scripts/release/preflight.ts",
    "release:package": "node scripts/release/package.ts",
    "release:package-standalone": "node scripts/release/package-standalone.ts",
    "release:checksums": "node scripts/release/checksums.ts",
    "release:install-smoke": "node scripts/release/install-smoke.ts",
    "release:standalone-smoke": "node scripts/release/standalone-smoke.ts",
    "release:rollback-smoke": "node scripts/release/validate-prior-rollback.ts",
    "release:soak": "node scripts/release/soak.ts"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "esbuild": "0.28.2",
    "eslint": "10.9.1",
    "fast-check": "4.9.0",
    "fflate": "0.8.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2"
  }
}
