{
  "name": "odinn",
  "version": "1.1.0-rc.1",
  "private": true,
  "description": "Local AI assistant with memory, audited tools, and user-controlled actions",
  "type": "module",
  "bin": {
    "odinn": "./apps/cli/src/cli.ts"
  },
  "packageManager": "pnpm@10.14.0",
  "pnpm": {
    "overrides": {
      "uuid@<11.1.1": "11.1.1",
      "brace-expansion@<5.0.9": "5.0.9"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "format:check": "node scripts/ci/run.ts format",
    "lint": "node scripts/ci/run.ts lint",
    "typecheck": "node scripts/ci/run.ts typecheck",
    "test": "node --test --test-concurrency=1 --test-reporter=spec tests/*.test.ts",
    "test:platform": "node --test --test-concurrency=1 --test-reporter=spec tests/platform.test.ts tests/resource-limits.test.ts tests/channels.test.ts tests/gateway-product-surfaces.test.ts",
    "test:gateway": "node --test --test-concurrency=1 --test-reporter=spec tests/gateway.test.ts tests/gateway-product-surfaces.test.ts",
    "test:integration": "node --test --test-concurrency=1 --test-reporter=spec tests/integration.test.ts",
    "test:oci": "node --test --test-concurrency=1 --test-reporter=spec tests/sandbox-oci.integration.test.ts tests/extension-oci.integration.test.ts",
    "test:migrations": "node --test --test-concurrency=1 --test-reporter=spec tests/state-migrations.test.ts",
    "test:lifecycle": "node --test --test-concurrency=1 --test-reporter=spec tests/application-lifecycle.test.ts tests/state-lifecycle.test.ts",
    "test:update": "node --test --test-concurrency=1 --test-reporter=spec --test-name-pattern=update tests/application-lifecycle.test.ts",
    "test:rollback": "node --test --test-concurrency=1 --test-reporter=spec --test-name-pattern=rollback tests/application-lifecycle.test.ts",
    "test:backup": "node --test --test-concurrency=1 --test-reporter=spec --test-name-pattern=backup tests/state-lifecycle.test.ts",
    "test:restore": "node --test --test-concurrency=1 --test-reporter=spec --test-name-pattern=restore tests/state-lifecycle.test.ts",
    "test:uninstall": "node --test --test-concurrency=1 --test-reporter=spec --test-name-pattern=uninstall tests/application-lifecycle.test.ts",
    "fuzz:security": "node scripts/ci/security-fuzz.ts",
    "fuzz:replay": "node scripts/ci/security-fuzz.ts",
    "test:compiled-release": "pnpm build && pnpm release:package && pnpm release:checksums && node scripts/release/verify.ts && node --test --test-concurrency=1 --test-reporter=spec tests/v1/compiled-release.test.ts",
    "build": "node scripts/ci/run.ts build",
    "build:production": "node scripts/build-production.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm smoke:onboarding && pnpm build",
    "odinn": "node ./apps/cli/src/cli.ts",
    "onboard": "pnpm --filter @odinn/cli start -- onboard",
    "tui": "pnpm --filter @odinn/cli start -- tui",
    "gui:start": "pnpm --filter @odinn/gateway start",
    "host:start": "node apps/gateway/src/host.ts",
    "smoke:inference": "node scripts/ci/inference-smoke.ts",
    "smoke:onboarding": "node scripts/ci/onboarding-smoke.ts",
    "storage:drill": "node scripts/ci/storage-drill.ts",
    "benchmark:assurance": "node scripts/ci/assurance-benchmark.ts",
    "benchmark:recovery": "node scripts/ci/recovery-benchmark.ts",
    "benchmark:workspace-inspection": "node --expose-gc scripts/ci/workspace-inspection-benchmark.ts",
    "benchmark:memory-index": "node scripts/ci/memory-index-benchmark.ts",
    "benchmark:authoritative-storage": "node scripts/ci/authoritative-storage-benchmark.ts",
    "benchmark:audit": "node scripts/ci/audit-benchmark.ts",
    "soak:audit": "node scripts/ci/audit-soak.ts",
    "benchmark:ci": "node scripts/ci/benchmark.ts && pnpm benchmark:assurance && pnpm benchmark:recovery && pnpm benchmark:workspace-inspection",
    "release:preflight": "node scripts/release/preflight.ts",
    "release:package": "node scripts/release/package.ts",
    "release:checksums": "node scripts/release/checksums.ts",
    "release:install-smoke": "node scripts/release/install-smoke.ts",
    "release:soak": "node scripts/release/soak.ts"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.2",
    "esbuild": "0.28.1",
    "eslint": "10.8.0",
    "fflate": "0.8.3",
    "fast-check": "4.9.0",
    "typescript": "7.0.2",
    "typescript-eslint": "8.66.0"
  }
}
