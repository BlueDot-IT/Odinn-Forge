{
  "name": "odinn",
  "version": "1.0.0",
  "private": true,
  "description": "Local AI assistant with memory, audited tools, and user-controlled actions",
  "type": "module",
  "bin": {
    "odinn": "./apps/cli/src/cli.ts"
  },
  "packageManager": "pnpm@10.14.0",
  "pnpm": {
    "overrides": {
      "uuid@<11.1.1": "11.1.1"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "format:check": "node scripts/ci/run.ts format",
    "lint": "node scripts/ci/run.ts lint",
    "typecheck": "node scripts/ci/run.ts typecheck",
    "test": "node --test --test-concurrency=1 --test-reporter=spec tests/*.test.ts",
    "test:platform": "node --test --test-reporter=spec tests/platform.test.ts",
    "test:integration": "node --test --test-reporter=spec tests/integration.test.ts",
    "test:migrations": "node --test --test-reporter=spec tests/state-migrations.test.ts",
    "test:lifecycle": "node --test --test-reporter=spec tests/application-lifecycle.test.ts tests/state-lifecycle.test.ts",
    "test:update": "node --test --test-reporter=spec --test-name-pattern=update tests/application-lifecycle.test.ts",
    "test:rollback": "node --test --test-reporter=spec --test-name-pattern=rollback tests/application-lifecycle.test.ts",
    "test:backup": "node --test --test-reporter=spec --test-name-pattern=backup tests/state-lifecycle.test.ts",
    "test:restore": "node --test --test-reporter=spec --test-name-pattern=restore tests/state-lifecycle.test.ts",
    "test:uninstall": "node --test --test-reporter=spec --test-name-pattern=uninstall tests/application-lifecycle.test.ts",
    "test:compiled-release": "pnpm build && pnpm release:package && pnpm release:checksums && node scripts/release/verify.ts && node --test --test-reporter=spec tests/v1/compiled-release.test.ts",
    "build": "node scripts/ci/run.ts build",
    "build:production": "node scripts/build-production.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm smoke:onboarding && pnpm build",
    "odinn": "node ./apps/cli/src/cli.ts",
    "onboard": "pnpm --filter @odinn/cli start -- onboard",
    "tui": "pnpm --filter @odinn/cli start -- tui",
    "gui:start": "pnpm --filter @odinn/gateway start",
    "host:start": "node apps/gateway/src/host.ts",
    "smoke:inference": "node scripts/ci/inference-smoke.ts",
    "smoke:onboarding": "node scripts/ci/onboarding-smoke.ts",
    "storage:drill": "node scripts/ci/storage-drill.ts",
    "benchmark:assurance": "node scripts/ci/assurance-benchmark.ts",
    "benchmark:memory-index": "node scripts/ci/memory-index-benchmark.ts",
    "benchmark:ci": "node scripts/ci/benchmark.ts && pnpm benchmark:assurance",
    "release:preflight": "node scripts/release/preflight.ts",
    "release:package": "node scripts/release/package.ts",
    "release:checksums": "node scripts/release/checksums.ts",
    "release:install-smoke": "node scripts/release/install-smoke.ts",
    "release:soak": "node scripts/release/soak.ts"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.10.1",
    "esbuild": "0.28.1",
    "eslint": "10.7.0",
    "fflate": "0.8.2",
    "fast-check": "4.9.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.64.0"
  }
}
